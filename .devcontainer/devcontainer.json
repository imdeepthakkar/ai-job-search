{
  "name": "AI Job Search (Antigravity)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [7681],
  "portsAttributes": {
    "7681": {
      "label": "AGY Web Terminal",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "ms-python.python",
        "James-Yu.latex-workshop"
      ]
    }
  },
  "remoteEnv": {
    "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}",
    "NOTION_TOKEN": "${localEnv:NOTION_TOKEN}",
    "GDRIVE_WEBHOOK_URL": "${localEnv:GDRIVE_WEBHOOK_URL}",
    "GDRIVE_FOLDER_ID": "${localEnv:GDRIVE_FOLDER_ID}",
    "GDRIVE_WEBHOOK_SECRET": "${localEnv:GDRIVE_WEBHOOK_SECRET}",
    "WEB_TERMINAL_PASSWORD": "${localEnv:WEB_TERMINAL_PASSWORD}"
  }
}
